# 忽略 Python 虚拟环境
venv/
.venv/
__pycache__/
*.py[cod]

# 忽略环境变量（千万别把 Key 传上去！）
.env
.env.*
!.env.example

# 忽略数据库和向量库
*.db
*.sqlite3
.chroma/

# 忽略前端依赖和构建产物
node_modules/
dist/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
*.log
# 压测生成的临时文件
tools/_stress_resume.docx
tools/_stress_result.json
tools/_stress_report_result.json
