# ===== 智聘引擎 InWriting 后端环境变量 =====
# 使用方式：复制本文件为 .env（cp .env.example .env），按实际部署情况修改。
# 未填写的项会使用代码内默认值，默认值与本地开发行为一致。

# ---------- 必填 ----------
# 智谱开放平台 API Key（https://open.bigmodel.cn 注册后可免费使用 GLM-4-Flash）
# 留空时系统仍可运行，但 AI 输出会走兜底文案，无法体现真实效果。
ZHIPUAI_API_KEY=your_api_key_here

# JWT 签名密钥。生产环境务必替换：openssl rand -hex 32
# 保持示例值时，服务启动会打印安全告警。
SECRET_KEY=dev-secret-key-change-me

# ---------- 存储（生产建议改为绝对路径）----------
# SQLite 默认写在当前工作目录；生产示例：sqlite:////opt/inwriting/data/inwriting.db
DATABASE_URL=sqlite:///./inwriting.db
# RAG 向量库目录；生产示例：/opt/inwriting/data/.chroma
CHROMA_DIR=./.chroma

# ---------- 网络 ----------
# 允许跨域的前端来源，逗号分隔。
# 同域部署（Nginx 把 /api 反代到后端）时前端与后端同源，此项可留空。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 大模型 ----------
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
EMBEDDING_MODEL=embedding-3
# 连接超时 / 读取超时（秒）
LLM_TIMEOUT_CONNECT=5
LLM_TIMEOUT_READ=20

# ---------- 业务开关 ----------
# 规划 Agent：true 开启（每轮由总控 Agent 决策 + 工具检索）；false 回退原始 Prompt 流程，延迟更低
ENABLE_PLANNER=true
# 简历上传大小上限（MB）
MAX_UPLOAD_MB=10
