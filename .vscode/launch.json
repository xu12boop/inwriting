{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端：FastAPI (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8001"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "后端：当前 Python 文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "前端：Vite dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "前端：Chrome 打开 5173",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "全栈：后端 + 前端 + 浏览器",
      "configurations": [
        "后端：FastAPI (uvicorn --reload)",
        "前端：Vite dev server",
        "前端：Chrome 打开 5173"
      ],
      "stopAll": true
    }
  ]
}
