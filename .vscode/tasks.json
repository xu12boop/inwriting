{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. 后端：安装依赖",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "2. 后端：启动服务 (8001)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe -m uvicorn app.main:app --reload --port 8001",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "3. 前端：安装依赖",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "4. 前端：启动 dev (5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "5. 前端：TypeScript 类型检查",
      "type": "shell",
      "command": "npm run type-check",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "6. 前端：生产构建",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$tsc"]
    }
  ]
}
